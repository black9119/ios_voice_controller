platform :ios, '12.0'

use_frameworks!

install! 'cocoapods',
  :disable_input_output_paths => true

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Flutter 3.19 正确写法
  flutter_install_ios_pods File.dirname(File.realpath(__FILE__))

  pod 'audioplayers_darwin', '0.1.1'
  pod 'shared_preferences_foundation', '0.1.5'
  pod 'path_provider_foundation', '0.1.5'
end
